# Ingatlan Kereső - Többkonténeres Docker Compose Konfiguráció

# Publikus Frontend Port a Host gépen (Alapértelmezett: 8080)
HOST_PORT=8080

# PostgreSQL Adatbázis Konfiguráció
POSTGRES_DB=ingatlandb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Opcionális: Egyedi konténer image címkék felülbírálása
# BACKEND_IMAGE=ghcr.io/luxeonn/ingatlan-kereso-backend:latest
# FRONTEND_IMAGE=ghcr.io/luxeonn/ingatlan-kereso-frontend:latest
