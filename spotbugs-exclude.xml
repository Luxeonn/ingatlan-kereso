<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude CLI explicit System.exit if present -->
    <Match>
        <Class name="ingatlanok.Main"/>
        <Bug pattern="DM_EXIT"/>
    </Match>

    <!-- Exclude test classes from SpotBugs -->
    <Match>
        <Class name="~.*Test(\$.*)?"/>
    </Match>

    <!-- Allow internal representation exposure in DTO, Model and ScrapeResult transfer objects -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- Allow non-private constructors in Singletons for testing and dependency injection -->
    <Match>
        <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
    </Match>

    <!-- Suppress benign patterns in parsers, managers, and sidecars -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE,REC_CATCH_EXCEPTION,CT_CONSTRUCTOR_THROW,DE_MIGHT_IGNORE,VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
</FindBugsFilter>
