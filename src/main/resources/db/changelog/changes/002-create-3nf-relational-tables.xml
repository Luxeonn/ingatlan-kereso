<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Portálok tábla (3NF: portals) -->
    <changeSet id="002-create-portals-table" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="portals"/>
            </not>
        </preConditions>
        <createTable tableName="portals">
            <column name="id" type="varchar(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="base_url" type="varchar(255)"/>
            <column name="color_hex" type="varchar(16)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true"/>
            <column name="rate_limit_ms" type="int" defaultValueNumeric="1000"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 2. Alapértelmezett portálok inicializálása -->
    <changeSet id="002-seed-initial-portals" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="portals"/>
        </preConditions>
        <sql>
            INSERT OR IGNORE INTO portals (id, name, base_url, color_hex, is_active, rate_limit_ms) VALUES
                ('dh', 'Duna House', 'https://dh.hu', '#e63946', 1, 1500),
                ('oc', 'Otthon Centrum', 'https://oc.hu', '#f77f00', 1, 1500),
                ('jofogas', 'Jófogás', 'https://jofogas.hu', '#2a9d8f', 1, 1000),
                ('ingatlanbazar', 'Ingatlanbazár', 'https://ingatlanbazar.hu', '#457b9d', 1, 800),
                ('koltozzbe', 'Költözzbe', 'https://koltozzbe.hu', '#6a4c93', 1, 1200),
                ('ingatlancom', 'Ingatlan.com', 'https://ingatlan.com', '#1d3557', 1, 2000),
                ('egyeb', 'Egyéb', '', '#6c757d', 1, 1000);
        </sql>
    </changeSet>

    <!-- 3. Települések tábla (3NF: locations) -->
    <changeSet id="002-create-locations-table" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="locations"/>
            </not>
        </preConditions>
        <createTable tableName="locations">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="normalized_slug" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="county" type="varchar(64)"/>
            <column name="zip_code" type="varchar(10)"/>
            <column name="latitude" type="real"/>
            <column name="longitude" type="real"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 4. Korábbi denormalizált tábla átnevezése átmenetileg migrációhoz -->
    <changeSet id="002-rename-legacy-properties" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="properties"/>
            <columnExists tableName="properties" columnName="portal"/>
        </preConditions>
        <sql>
            ALTER TABLE properties RENAME TO properties_legacy;
        </sql>
    </changeSet>

    <!-- 5. Új 3NF Normalizált Hirdetések főtábla (properties) -->
    <changeSet id="002-create-3nf-properties-table" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="properties"/>
            </not>
        </preConditions>
        <createTable tableName="properties">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="portal_id" type="varchar(32)">
                <constraints nullable="false" foreignKeyName="fk_properties_portal" references="portals(id)"/>
            </column>
            <column name="location_id" type="varchar(64)">
                <constraints nullable="false" foreignKeyName="fk_properties_location" references="locations(id)"/>
            </column>
            <column name="external_id" type="varchar(128)"/>
            <column name="url" type="varchar(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE"/>
            <column name="discovered_at" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="viewed" type="int" defaultValueNumeric="0"/>
            <column name="viewed_at" type="varchar(64)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 6. Hirdetés attribútumok reláció (1:1 / 3NF: property_attributes) -->
    <changeSet id="002-create-property-attributes-table" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="property_attributes"/>
            </not>
        </preConditions>
        <createTable tableName="property_attributes">
            <column name="property_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_prop_attr_property" references="properties(id)" deleteCascade="true"/>
            </column>
            <column name="price_raw" type="varchar(64)"/>
            <column name="price_amount" type="bigint"/>
            <column name="price_millions" type="real"/>
            <column name="price_per_sqm" type="real"/>
            <column name="area_sqm" type="real"/>
            <column name="rooms" type="real"/>
            <column name="property_type" type="varchar(32)"/>
            <column name="condition" type="varchar(32)"/>
            <column name="heating_type" type="varchar(64)"/>
            <column name="land_sqm" type="real"/>
            <column name="raw_description" type="clob"/>
        </createTable>
    </changeSet>

    <!-- 7. Hirdetés képek reláció (1:N / 3NF: property_images) -->
    <changeSet id="002-create-property-images-table" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="property_images"/>
            </not>
        </preConditions>
        <createTable tableName="property_images">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="property_id" type="varchar(64)">
                <constraints nullable="false" foreignKeyName="fk_prop_images_property" references="properties(id)" deleteCascade="true"/>
            </column>
            <column name="image_url" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="order_index" type="int" defaultValueNumeric="0"/>
            <column name="is_primary" type="boolean" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!-- 8. Korábbi adatok átmozgatása a normalizált 3NF táblákba -->
    <changeSet id="002-migrate-legacy-data" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="properties_legacy"/>
        </preConditions>
        <sql>
            -- 1. Ismeretlen portálok rögzítése a portals táblába
            INSERT OR IGNORE INTO portals (id, name, base_url, color_hex, is_active, rate_limit_ms)
            SELECT DISTINCT lower(portal), portal, '', '#6c757d', 1, 1000
            FROM properties_legacy WHERE portal IS NOT NULL;

            -- 2. Települések rögzítése a locations táblába
            INSERT OR IGNORE INTO locations (id, name, normalized_slug)
            SELECT DISTINCT city_key, city, city_key
            FROM properties_legacy WHERE city_key IS NOT NULL;

            -- 3. Hirdetések átmozgatása az új properties táblába
            INSERT OR IGNORE INTO properties (
                id, portal_id, location_id, url, title, status, discovered_at, viewed, viewed_at, created_at, updated_at
            )
            SELECT
                id,
                lower(COALESCE(portal, 'egyeb')),
                COALESCE(city_key, 'debrecen'),
                url,
                title,
                'ACTIVE',
                discovered_at,
                viewed,
                viewed_at,
                created_at,
                created_at
            FROM properties_legacy;

            -- 4. Attribútumok átmozgatása a property_attributes táblába
            INSERT OR IGNORE INTO property_attributes (
                property_id, price_raw, price_amount, price_millions, price_per_sqm, area_sqm, rooms, raw_description
            )
            SELECT
                id,
                price_raw,
                price_amount,
                price_millions,
                price_per_sqm,
                area_sqm,
                rooms,
                details
            FROM properties_legacy;

            -- 5. Képek átmozgatása a property_images táblába
            INSERT OR IGNORE INTO property_images (
                property_id, image_url, order_index, is_primary
            )
            SELECT
                id,
                image_url,
                0,
                1
            FROM properties_legacy
            WHERE image_url IS NOT NULL AND image_url != '';

            -- 6. Régi átmeneti tábla törlése
            DROP TABLE properties_legacy;
        </sql>
    </changeSet>

    <!-- 9. 3NF Teljesítmény indexek -->
    <changeSet id="002-create-3nf-indexes" author="ingatlan-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_properties_portal_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_properties_portal_id" tableName="properties">
            <column name="portal_id"/>
        </createIndex>
        <createIndex indexName="idx_properties_location_id" tableName="properties">
            <column name="location_id"/>
        </createIndex>
        <createIndex indexName="idx_properties_url" tableName="properties">
            <column name="url"/>
        </createIndex>
        <createIndex indexName="idx_properties_discovered_at" tableName="properties">
            <column name="discovered_at"/>
        </createIndex>
        <createIndex indexName="idx_properties_viewed" tableName="properties">
            <column name="viewed"/>
        </createIndex>
        <createIndex indexName="idx_locations_slug" tableName="locations">
            <column name="normalized_slug"/>
        </createIndex>
        <createIndex indexName="idx_prop_attr_price_amount" tableName="property_attributes">
            <column name="price_amount"/>
        </createIndex>
        <createIndex indexName="idx_prop_attr_area_sqm" tableName="property_attributes">
            <column name="area_sqm"/>
        </createIndex>
        <createIndex indexName="idx_prop_images_property_id" tableName="property_images">
            <column name="property_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
